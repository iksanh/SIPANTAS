# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/
venv/
env/

# Basis data dan data lapangan (berisi data pribadi, jangan dilacak)
data/
backup/
*.db
*.db-journal
*.db-wal
*.db-shm
*.db.bak*
*.sqlite
*.sqlite3
*.bak

# Keluaran dan singgahan - selalu bisa dibuat ulang dari basis data
keluaran/
pratinjau/

# Cadangan otomatis templat
templates/cadangan/

# Berkas sementara Microsoft Office / LibreOffice
~$*
.~lock.*#

# Berkas sementara dan log
tmp/
temp/
*.tmp
*.log
logs/

# Setelan pemasangan: memuat kata sandi basis data.
# .env.contoh tetap dilacak sebagai contoh.
.env
.env.*
!.env.contoh

# Hasil alat uji
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Setelan editor dan sistem
.vscode/
.idea/
.claude/
*.swp
*~
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# Rekaman uji acuan - dibuat ulang dengan: python -m uji.bikin_emas
# Tidak dilacak karena isinya data pemohon yang sebenarnya (nama, NIK,
# alamat, letak tanah), sama alasannya dengan folder data/.
uji/emas/
