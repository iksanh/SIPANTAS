# Salin ke /etc/sipantas.env lalu isi nilainya. chmod 600, milik root.
# Dibaca systemd (EnvironmentFile) untuk sipantas.service dan sipantas-backup.service.

# Teks acak panjang, tetap. Buat sekali dengan:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
KUNCI_RAHASIA=ganti_dengan_64_karakter_hex_acak

# 1 karena nginx ber-HTTPS ada di depan: kuki sesi ditandai Secure.
HTTPS=1

# Jam kantor. Waktu di basis data dihitung Python dari jam lokal.
TZ=Asia/Makassar

# Basis data. Bawaan: SQLite di data/berkas.db (data/ adalah symlink ke
# /data/sipantas/data). Isi DB_URL hanya kalau pindah ke PostgreSQL.
# DB_URL=postgresql://panitia:ganti-sandinya@127.0.0.1:5432/panitia_a

# Dipakai backup.sh
TUJUAN_S3=s3://cadangan-bpn-bonbol/sipantas
SIMPAN_HARI=30
