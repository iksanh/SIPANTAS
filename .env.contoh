# Salin jadi .env lalu sesuaikan. Berkas .env tidak dilacak git karena
# memuat kata sandi. Variabel lingkungan sungguhan mengalahkan isi berkas ini.

# ---------------------------------------------------------------- basis data
# Bawaan, tanpa setelan apa pun: SQLite di data/berkas.db
# DB_URL=sqlite:///data/berkas.db

# PostgreSQL:
# DB_URL=postgresql://panitia:ganti-sandinya@127.0.0.1:5432/panitia_a
#
# Kata sandi yang memuat @ : / atau ? harus disandikan di dalam URL
# (@ jadi %40, / jadi %2F). Kalau merepotkan, pakai bentuk per bagian:
# DB_JENIS=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=panitia
# DB_PASSWORD=sandi@apa/adanya
# DB_NAMA=panitia_a
# DB_SSLMODE=require

# ------------------------------------------------------------------ aplikasi
# Teks acak panjang, tetap. Kalau kosong, dibuatkan baru tiap layanan
# dinyalakan ulang.
# KUNCI_RAHASIA=

# 1 bila ada nginx/Caddy ber-HTTPS di depan; menandai kuki sesi Secure.
# HTTPS=1

# ALAMAT=127.0.0.1
# PORTA=8000
# UTAS=8
